# ─── Supabase ────────────────────────────────────────────
# Local dev (Vite): must use VITE_ prefix so the client bundle gets them.
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# cPanel Node.js + Phusion Passenger: if the app still listens on a TCP port and Passenger
# fails to start, add environment variable AUTOWISE_PASSENGER=1 so app.js uses listen('passenger').
# Do not set PORT=3001 unless your host requires it for non-Passenger mode.

# cPanel Node.js app: set the SAME names in "Environment variables" (recommended).
# app.js injects them into index.html at runtime, so you do NOT need to rebuild
# after changing keys on the server. Optional aliases:
# SUPABASE_URL=...
# SUPABASE_KEY=...   (anon/public key is enough for leads + browser client with RLS)

# ─── SMTP (Email) ───────────────────────────────────────
# cPanel → Email Accounts: create mailbox, then use that FULL address as SMTP_USER.
# While debugging SMTP, you can disable sending the welcome email (lead still saved):
# SKIP_WELCOME_EMAIL=1
# (alias: AUTOWISE_SKIP_WELCOME_EMAIL=1)

# If you get 535 Incorrect authentication: wrong password, or wrong SSL mode.
# Try port 587 + STARTTLS:
#   SMTP_PORT=587
#   SMTP_SECURE=false
# For implicit SSL (common on cPanel):
#   SMTP_PORT=465
#   SMTP_SECURE=true   (or omit; default is secure on 465)
SMTP_HOST=mail.autowise-dz.com
SMTP_PORT=465
SMTP_SECURE=
SMTP_USER=contact@autowise-dz.com
SMTP_PASS=your-mailbox-password
SMTP_FROM=contact@autowise-dz.com

# ─── Server ─────────────────────────────────────────────
PORT=3001
