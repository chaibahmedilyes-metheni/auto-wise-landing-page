# ─── Supabase ────────────────────────────────────────────
# Used by Vite (frontend) — must start with VITE_
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=your-supabase-anon-key

# Used by app.js (backend) — optional overrides, falls back to VITE_ vars
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_KEY=your-supabase-service-role-key

# ─── SMTP (Email) ───────────────────────────────────────
SMTP_HOST=mail.autowise-dz.com
SMTP_PORT=465
SMTP_USER=contact@autowise-dz.com
SMTP_PASS=your-password
SMTP_FROM=contact@autowise-dz.com

# ─── Server ─────────────────────────────────────────────
PORT=3001
